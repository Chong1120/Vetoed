.env
.env.*
!.env.example
.alpaca/
*.pem
*.key

# --- Python ---
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- Data / journal ---
*.db
*.db-journal
*.db-wal
*.db-shm
journal/*
!journal/.gitkeep
# The decision journal IS the demo - it is what the deployed dashboard
# renders and what judges inspect. Checked before committing: it holds no
# keys, no Alpaca account id, and no order ids. Paper trading only.
!journal/trades.db
# The same journal as plain JSON, rewritten every cycle. The published page
# reads it from raw.githubusercontent.com so it does not have to wait for a
# Pages rebuild, which during a session never comes. Same content as the .db
# above, minus the model's raw responses and the broker's raw order objects.
!journal/data.json

# --- Editor / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

