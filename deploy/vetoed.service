; Vetoed - autonomous options agent. ALPACA PAPER TRADING ONLY.
;
; Install to /etc/systemd/system/vetoed.service (see deploy/install.sh).
;
; Secrets are NOT in this file. EnvironmentFile points at /opt/vetoed/.env,
; which install.sh chmods to 600 and owns as the service user - a unit file is
; world-readable, so an API key in it would be readable by every account on
; the box.

[Unit]
Description=Vetoed options agent (Alpaca paper trading)
Documentation=https://github.com/Chong1120/Vetoed
After=network-online.target
Wants=network-online.target

; A crash loop is usually a bad .env or an expired key. Restarting five times
; in ten minutes and then stopping surfaces that in `systemctl status` instead
; of hiding it in an endless retry.
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=vetoed
Group=vetoed
WorkingDirectory=/opt/vetoed

; ALPACA_PAPER_TRADE=true must be in here. agent/loop.py refuses to start
; without it, so a missing or wrong value fails the unit rather than trading.
EnvironmentFile=/opt/vetoed/.env

; --live means "submit orders", NOT "use real money". There is no real-money
; mode in this codebase. --schedule runs continuously; the agent checks
; Alpaca's own clock each cycle and does nothing while the market is shut.
; --force is deliberately absent and is refused in combination with --schedule.
ExecStart=/opt/vetoed/.venv/bin/python -m agent.loop --live --schedule

Restart=always
RestartSec=30

; systemd stops units with SIGTERM. loop.py handles it, finishes the cycle in
; flight, and releases the run lock. 120s is longer than a cycle's worst case.
KillSignal=SIGTERM
TimeoutStopSec=120

StandardOutput=journal
StandardError=journal
SyslogIdentifier=vetoed

; --- hardening ------------------------------------------------------------
; The agent needs the network and one writable directory. Nothing else.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/vetoed/journal
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
