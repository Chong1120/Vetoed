# TEMPLATE ONLY - THIS FILE IS COMMITTED TO THE PUBLIC REPO.
# Never put real keys here. Put them in .env (which is gitignored).
#
#   Copy-Item .env.example .env      then edit .env

# --- Alpaca PAPER trading credentials ---
# From https://app.alpaca.markets/paper/dashboard/overview -> "API Keys"
# Paper keys start with PK. Live keys start with AK - do not use those.
ALPACA_API_KEY=PK_your_paper_key_here
ALPACA_SECRET_KEY=your_paper_secret_here

# Hard safety rail. Must remain true for this project.
ALPACA_PAPER_TRADE=true

# Endpoint. You do NOT normally need to set this: alpaca-py derives the
# correct paper URL from paper=True. It is here only because the Alpaca MCP
# server and CLI ask for it explicitly later on.
# ALPACA_API_BASE_URL=https://paper-api.alpaca.markets

# --- Judgement layer (OPTIONAL - the agent trades without it) ---
# With no provider configured, brain.py uses deterministic selection: the
# top-scoring candidate that clears a fixed bar. Every risk gate is identical
# either way, so this is a degradation, not an outage.
#
# Featherless AI - open-weight models, OpenAI-compatible, and the hackathon's
# partner. Preferred when both keys are present.
#   https://featherless.ai  ->  dashboard  ->  API keys
FEATHERLESS_API_KEY=your_featherless_key_here
# Optional. Override if the default is not on your plan; check_llm.py says so.
# FEATHERLESS_MODEL=Qwen/Qwen2.5-72B-Instruct

# Anthropic - used only if FEATHERLESS_API_KEY is absent.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Force one provider instead of auto-detecting: featherless | anthropic | none
# BRAIN_PROVIDER=featherless

# --- Unattended operation (optional) ---
# Minutes between cycles while --schedule is running. Default 30.
#
# 30 is the production default because a cycle's inputs barely move faster
# than that: a 20-day realised-vol estimate and 2-14 DTE Greeks drift slowly.
# Polling faster re-examines the same candidates and burns API and Claude
# quota; it does not surface better trades.
#
# This is CONFIGURATION, not strategy - every gate, threshold and exit rule is
# identical at any interval. Short values are for demos. Range 1-240; anything
# outside it falls back to 30 with a warning.
# POLL_INTERVAL_MINUTES=30
